# Port d'écoute
PORT=3000
HOST=0.0.0.0

# Identifiants de l'espace privé (/admin) — mot de passe : 12 caractères minimum
ADMIN_USER=admin
ADMIN_PASSWORD=change-moi-tout-de-suite

# Clé de chiffrement des mots de passe SSH (32 caractères minimum).
# Générer avec : openssl rand -hex 32
# ⚠️ Ne la perdez pas : sans elle, les mots de passe enregistrés sont illisibles.
MASTER_KEY=

# Mettre à true derrière un reverse proxy HTTPS (Nginx, Caddy, Traefik...)
COOKIE_SECURE=false
TRUST_PROXY=false

# Durée d'une session (heures)
SESSION_HOURS=12

# Historique : mesures détaillées (jours) et agrégats horaires (jours)
RETENTION_DAYS=30
RETENTION_HOURLY_DAYS=365

# Notifications Discord (l'URL peut aussi être réglée dans l'espace privé, bouton « Notifications »)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Nombre d'échecs consécutifs avant d'annoncer une panne, et délai de revérification (s)
ALERT_AFTER_FAILURES=2
RETRY_SEC=20
