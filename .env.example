# Port d'écoute
PORT=3000
HOST=0.0.0.0

# Identifiants de l'espace privé (/admin) — mot de passe : 12 caractères minimum
ADMIN_USER=admin
ADMIN_PASSWORD=change-moi-tout-de-suite

# Clé de chiffrement des mots de passe SSH (32 caractères minimum).
# Générer avec : openssl rand -hex 32
# ⚠️ Ne la perdez pas : sans elle, les mots de passe enregistrés sont illisibles.
MASTER_KEY=

# Mettre à true derrière un reverse proxy HTTPS (Nginx, Caddy, Traefik...)
COOKIE_SECURE=false
TRUST_PROXY=false

# Durée d'une session (heures) et conservation de l'historique (jours)
SESSION_HOURS=12
RETENTION_DAYS=30
